---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Footer } from "../components/Footer";
import { Nav } from "../components/Nav";
import { BudgetSection } from "@/components/home/BudgetSection";
import { ClosingCta } from "@/components/home/ClosingCta";
import { Concepts } from "@/components/home/Concepts";
import { Deployments } from "@/components/home/Deployments";
import { ExperimentSection } from "@/components/home/ExperimentSection";
import { Hero } from "@/components/home/Hero";
import { PolicySection } from "@/components/home/PolicySection";
import { Thesis } from "@/components/home/Thesis";
---

<BaseLayout
  title="Keynes — Runtime economics for agents"
  description="Give your agents observability into your business with programmable resource controls for tokens, tools, time, and more."
>
  <Nav />
  <main>
    <Hero />
    <Concepts />
    <BudgetSection />
    <PolicySection client:load />
    <ExperimentSection client:load />
    <Thesis />
    <Deployments />
    <ClosingCta />
  </main>
  <Footer />
</BaseLayout>

<!-- Register the server-rendered hero drawing in the browser. -->
<script>
  import "@/lib/conveyor/element.js";
</script>
