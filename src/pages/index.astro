---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Footer } from "../components/Footer";
import { Nav } from "../components/Nav";
import { ClosingCta } from "@/components/home/ClosingCta";
import { Concepts } from "@/components/home/Concepts";
import { Deployments } from "@/components/home/Deployments";
import { ExperimentSection } from "@/components/home/ExperimentSection";
import { Hero } from "@/components/home/Hero";
import { RuntimeSection } from "@/components/home/RuntimeSection";
import { Technology } from "@/components/home/Technology";
import { Thesis } from "@/components/home/Thesis";
import { highlightRuntimeCode } from "@/lib/runtime-code";
import { SectionDivider } from "@/components/SectionDivider";

const runtimeCode = await highlightRuntimeCode();
---

<BaseLayout
  title="Keynes — Runtime economics for agents"
  description="Give your agents observability into your business with programmable resource controls for tokens, tools, time, and more."
>
  <Nav client:load />
  <main>
    <Hero />
    <SectionDivider />
    <Concepts />
    <SectionDivider />
    <RuntimeSection client:load code={runtimeCode} />
    <SectionDivider />
    <Technology />
    <SectionDivider />
    <ExperimentSection client:load />
    <SectionDivider />
    <Thesis />
    <SectionDivider />
    <Deployments />
    <SectionDivider />
    <ClosingCta />
    <SectionDivider />
  </main>
  <Footer />
</BaseLayout>

<!-- Register the server-rendered hero drawing in the browser. -->
<script>
  import "@/lib/conveyor/element.js";
</script>
