---
import { Icon } from "astro-icon/components";
import Section from "@/components/section/Section.astro";

const groups = [
  {
    title: "Reusable",
    icon: "hugeicons:arrow-reload-horizontal",
    resources: [
      {
        title: "Human reviewers",
        icon: "hugeicons:user-check-01",
      },
      {
        title: "Browser sessions",
        icon: "hugeicons:browser",
      },
      {
        title: "Agent runs",
        icon: "hugeicons:calendar-03",
      },
      {
        title: "Software seats",
        icon: "hugeicons:tools",
      },
      {
        title: "Sandbox slots",
        icon: "hugeicons:computer-cloud",
      },
      {
        title: "GPU slots",
        icon: "hugeicons:gpu",
      },
    ],
  },
  {
    title: "Consumable",
    icon: "hugeicons:coins-01",
    resources: [
      {
        title: "Inference tokens",
        icon: "hugeicons:ai-brain-01",
      },
      {
        title: "Usage credits",
        icon: "hugeicons:coins-01",
      },
      {
        title: "Tool calls",
        icon: "hugeicons:tools",
      },
      {
        title: "Runtime minutes",
        icon: "hugeicons:clock-01",
      },
      {
        title: "SMS messages",
        icon: "hugeicons:message-01",
      },
      {
        title: "Refund dollars",
        icon: "hugeicons:money-bag-02",
      },
    ],
  },
] as const;
---

<Section aria-label='Resource examples' padded={false}>
  <header class='relative z-10 flex flex-col gap-4 px-4 py-8 sm:px-8 sm:py-10'>
    <h2>Model every resource</h2>
    <p class='section-description max-w-2xl'>
      When resource limits are scattered across prompts and application code,
      they become impossible to manage. Keynes makes those limits explicit and
      enforceable.
    </p>
  </header>

  <div
    slot='full-bleed'
    class='grid grid-cols-1 border-t md:grid-cols-2 md:[&>section+section]:border-l'
  >
    {
      groups.map((group) => (
        <section class='min-w-0 border-t first:border-t-0 md:border-t-0'>
          <header class='border-b px-4 py-2'>
            <h2 class='text-sm font-medium tracking-tight text-foreground'>
              <span class='flex items-center gap-2'>
                <Icon
                  name={group.icon}
                  class='size-4 text-foreground'
                  stroke-width='1.5'
                  aria-hidden='true'
                />
                {group.title}
              </span>
            </h2>
          </header>
          <div class='grid grid-cols-2 [&>article:nth-child(odd)]:border-r [&>article:nth-last-child(-n+2)]:border-b-0'>
            {group.resources.map((resource) => (
              <article class='flex min-w-0 items-center gap-3 border-b p-4 text-muted-foreground transition-colors hover:bg-card hover:text-foreground'>
                <Icon
                  name={resource.icon}
                  class='size-4'
                  stroke-width='1.5'
                  aria-hidden='true'
                />
                <p class='min-w-0 text-sm'>{resource.title}</p>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Section>
