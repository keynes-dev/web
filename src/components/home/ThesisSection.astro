---
import Section from "@/components/section/Section.astro";
import Button from "@/components/ui/Button.astro";
---

<Section rails="dashed">
  <div class="flex flex-col items-center gap-8">
    <header class="relative flex max-w-3xl flex-col gap-4 text-center">
      <h2>Observability is a two-way street</h2>
      <p class="text-base leading-relaxed text-muted-foreground">
        Traditional observability tells your business what your agents did{" "}
        <em class="text-foreground underline underline-offset-4">after</em> they
        did it. Keynes gives your agents live business context{" "}
        <em class="text-foreground underline underline-offset-4">before</em>{" "}
        they act and lets you define how they should respond in advance.
      </p>
    </header>
    <Button href="/thesis" size="lg" variant="outline">
      Read thesis
    </Button>
  </div>
</Section>
