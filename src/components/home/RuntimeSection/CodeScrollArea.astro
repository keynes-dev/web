---
interface Props {
  class?: string;
  label: string;
}
const { class: className, label } = Astro.props;
---

<div class:list={["relative min-h-0 flex-1", className]} data-code-scroll-area>
  <div
    class="h-full min-h-0 overflow-auto"
    aria-label={label}
    data-code-scroll-content
  >
    <slot />
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t from-card to-transparent opacity-0 transition-opacity"
    data-code-scroll-fade
  ></div>
</div>

<script>
  for (const area of document.querySelectorAll<HTMLElement>(
    "[data-code-scroll-area]",
  )) {
    const content = area.querySelector<HTMLElement>(
      "[data-code-scroll-content]",
    );
    const fade = area.querySelector<HTMLElement>("[data-code-scroll-fade]");
    if (!content || !fade) continue;
    const update = () =>
      fade.classList.toggle(
        "opacity-100",
        content.scrollHeight - content.clientHeight - content.scrollTop > 1,
      );
    const observer = new ResizeObserver(update);
    observer.observe(content);
    content.addEventListener("scroll", update, { passive: true });
    requestAnimationFrame(update);
  }
</script>
