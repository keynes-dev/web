---
import { resourceTextures, type ResourceTexture } from "./resource-textures";

interface Props {
  kind: ResourceTexture;
}
const { kind } = Astro.props;
---

<span
  aria-hidden="true"
  class="inline-flex h-3 w-4 shrink-0 overflow-hidden border border-foreground"
>
  <i
    class="min-w-0 flex-1 bg-foreground mask-center mask-repeat-x not-italic"
    style={`mask-image: ${resourceTextures[kind]}`}
  ></i>
</span>
