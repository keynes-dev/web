---
import { resourceTextures, type ResourceTexture } from "./resource-textures";

interface Props {
  available: number;
  reserved: number;
  used: number;
  label: string;
}

const { available, reserved, used, label } = Astro.props;
const segments = [
  { kind: "available", quantity: available },
  { kind: "reserved", quantity: reserved },
  { kind: "used", quantity: used },
] satisfies ReadonlyArray<{ kind: ResourceTexture; quantity: number }>;
---

<div
  class="flex h-3 overflow-hidden border border-foreground"
  role="img"
  aria-label={label}
  title={label}
>
  {
    segments.map(({ kind, quantity }) => (
      <i
        aria-hidden="true"
        class="min-w-0 bg-foreground mask-center mask-repeat-x"
        style={`mask-image: ${resourceTextures[kind]}; flex: ${quantity}`}
      ></i>
    ))
  }
</div>
