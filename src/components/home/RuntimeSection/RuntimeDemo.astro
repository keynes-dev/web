---
import { Icon } from "astro-icon/components";
import Card from "@/components/ui/Card.astro";
import CardHeader from "@/components/ui/CardHeader.astro";
import CardTitle from "@/components/ui/CardTitle.astro";
import CardContent from "@/components/ui/CardContent.astro";
import CardFooter from "@/components/ui/CardFooter.astro";
import BudgetTree from "./BudgetTree.astro";
import CodeScrollArea from "./CodeScrollArea.astro";
import ResourceSwatch from "./ResourceSwatch.astro";
import { policyLineCount, runtimeCode } from "./code";
import { runtimeTabs } from "./tabs";
---

<div
  class='mx-auto w-full max-w-sm'
  aria-label='Keynes runtime example'
  data-runtime-demo
>
  <div
    hidden
    class='w-fit max-w-full overflow-x-auto'
    role='tablist'
    aria-label='Demo views'
    data-runtime-tablist
  >
    {
      runtimeTabs.map((tab, index) => (
        <button
          class:list={[
            "shrink-0 border-t-2 border-r-2 bg-sky-100 px-3 py-2 font-mono text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground aria-selected:bg-foreground aria-selected:text-background aria-selected:hover:bg-foreground aria-selected:hover:text-background",
            index === 0 && "rounded-tl-sm border-l-2",
            index === runtimeTabs.length - 1 && "rounded-tr-sm",
          ]}
          id={`runtime-tab-${tab.id}`}
          role='tab'
          type='button'
          aria-controls={`runtime-panel-${tab.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          data-runtime-tab={tab.id}
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  <Card
    class='mt-4 rounded-tl-none'
    aria-label='Runtime view'
    id='runtime-panel-runtime'
    role='tabpanel'
    aria-labelledby='runtime-tab-runtime'
    tabindex='0'
    data-runtime-panel='runtime'
  >
    <CardContent
      class='relative items-center overflow-hidden'
      data-runtime-panel-content
    >
      <BudgetTree />
    </CardContent>
    <CardFooter>
      <div
        class='flex w-full flex-wrap items-center justify-end gap-4 text-xs text-muted-foreground'
      >
        <span class='flex items-center gap-1.5'>
          <ResourceSwatch kind='available' />
          Available
        </span>
        <span class='flex items-center gap-1.5'>
          <ResourceSwatch kind='reserved' />
          Reserved
        </span>
        <span class='flex items-center gap-1.5'>
          <ResourceSwatch kind='used' />
          Used
        </span>
      </div>
    </CardFooter>
  </Card>

  <Card
    class='mt-4 rounded-tl-none'
    aria-label='Budgets view'
    id='runtime-panel-budget'
    role='tabpanel'
    aria-labelledby='runtime-tab-budget'
    tabindex='0'
    data-runtime-panel='budget'
  >
    <CardHeader
      class='flex items-center justify-between gap-3 rounded-tl-none bg-taupe-700'
    >
      <CardTitle class='text-xs'>budgets.ts</CardTitle>
      <span class='font-mono text-xs text-background'>{`{}`} TypeScript</span>
    </CardHeader>
    <CardContent class='flex min-h-0 flex-1 flex-col p-0'>
      <CodeScrollArea label='Budget definition code'>
        <pre
          class='m-0 overflow-visible whitespace-pre-wrap break-words bg-transparent p-3 font-mono text-xs leading-snug'><code data-code>{runtimeCode.budgets}</code></pre>
      </CodeScrollArea>
    </CardContent>
  </Card>

  <Card
    class='mt-4 overflow-hidden rounded-tl-none'
    aria-label='Policies view'
    id='runtime-panel-policy'
    role='tabpanel'
    aria-labelledby='runtime-tab-policy'
    tabindex='0'
    data-runtime-panel='policy'
  >
    <CardHeader
      class='flex items-center justify-between gap-3 rounded-tl-none bg-taupe-700 font-mono text-xs text-background'
    >
      <CardTitle class='text-xs'>
        <Icon
          name='hugeicons:play'
          class='mr-2 inline size-4'
          aria-hidden='true'
        />
        lead_enrichment_policy.sql
      </CardTitle>
      <span
        class='flex items-center gap-1.5'
        aria-label='Data source: policy views'
      >
        <Icon
          name='hugeicons:database-01'
          class='size-3.5'
          aria-hidden='true'
        />
        Policy
        <Icon
          name='hugeicons:arrow-down-01'
          class='size-3.5'
          aria-hidden='true'
        />
      </span>
    </CardHeader>
    <CardContent class='flex min-h-0 flex-1 flex-col p-0'>
      <CodeScrollArea label='Policy SQL query'>
        <div class='flex min-w-max p-3'>
          <pre
            class='mr-3 border-r border-taupe-400 pr-3 text-right font-mono text-xs leading-snug text-taupe-300'
            aria-hidden='true'>{Array.from({ length: policyLineCount }, (_, index) => index + 1).join("\n")}</pre>
          <pre
            class='m-0 whitespace-pre font-mono text-xs leading-snug'><code data-code>{runtimeCode.policies}</code></pre>
        </div>
      </CodeScrollArea>
    </CardContent>
    <CardFooter class='p-0'>
      <p class='border-b px-3 py-2 font-mono text-xs text-muted-foreground'>
        1 row returned
      </p>
      <div class='overflow-auto'>
        <table class='w-full border-collapse font-mono text-xs'>
          <tbody>
            <tr class='border-t'>
              <th
                class='w-1/3 border-r px-3 py-2 text-left font-normal text-muted-foreground'
              >
                decision
              </th>
              <td class='px-3 py-2 font-medium text-emerald-500'>APPROVED</td>
            </tr>
            <tr class='border-t'>
              <th
                class='border-r px-3 py-2 text-left font-normal text-muted-foreground'
              >
                intent_score
              </th>
              <td class='px-3 py-2'>84</td>
            </tr>
            <tr class='border-t'>
              <th
                class='border-r px-3 py-2 text-left font-normal text-muted-foreground'
              >
                resources
              </th>
              <td class='px-3 py-2'>{`[{ data_credits: 6 }]`}</td>
            </tr>
            <tr class='border-t'>
              <th
                class='border-r px-3 py-2 text-left font-normal text-muted-foreground'
              >
                reason
              </th>
              <td class='px-3 py-2'>within_intent_limit</td>
            </tr>
          </tbody>
        </table>
      </div>
    </CardFooter>
  </Card>

  <Card
    class='mt-4 overflow-hidden rounded-tl-none'
    aria-label='Workflow view'
    id='runtime-panel-workflow'
    role='tabpanel'
    aria-labelledby='runtime-tab-workflow'
    tabindex='0'
    data-runtime-panel='workflow'
  >
    <CardHeader
      class='flex items-center justify-between gap-3 rounded-tl-none bg-taupe-700 font-mono text-xs text-background'
    >
      <CardTitle class='text-xs'>lead-enrichment.ts</CardTitle>
      <span>{`{}`} TypeScript</span>
    </CardHeader>
    <CardContent class='flex min-h-0 flex-1 flex-col p-0'>
      <CodeScrollArea label='Lead enrichment application workflow'>
        <pre
          class='m-0 overflow-visible whitespace-pre-wrap break-words bg-transparent p-3 font-mono text-xs leading-snug'><code data-code>{runtimeCode.workflow}</code></pre>
      </CodeScrollArea>
    </CardContent>
  </Card>
</div>
