---
import Card from "@/components/ui/Card.astro";
import CardHeader from "@/components/ui/CardHeader.astro";
import CardTitle from "@/components/ui/CardTitle.astro";
import CardContent from "@/components/ui/CardContent.astro";
interface Props {
  status: "approved" | "denied";
  detail: string;
}
const { status, detail } = Astro.props;
const styles =
  status === "approved"
    ? {
        label: "Approved",
        swatch: "bg-success-indicator",
        header: "bg-success-subtle",
      }
    : {
        label: "Denied",
        swatch: "bg-danger-indicator",
        header: "bg-danger-subtle",
      };
---

<Card aria-label={`${styles.label}: ${detail}`}>
  <CardHeader
    class={[
      styles.header,
      "flex items-center justify-between py-1.5 text-xs text-foreground",
    ].join(" ")}
  >
    <CardTitle class="font-sans text-xs text-foreground">Agent</CardTitle>
    <span class="flex min-w-0 items-center gap-2">
      <span
        aria-hidden="true"
        class:list={[styles.swatch, "size-2 shrink-0 rounded-full"]}
      ></span>
      <span class="font-mono text-xs">{styles.label}</span>
    </span>
  </CardHeader>
  <CardContent class="flex items-center justify-between gap-2 bg-background">
    <span class="truncate font-mono text-xs text-muted-foreground">
      {detail}
    </span>
  </CardContent>
</Card>
