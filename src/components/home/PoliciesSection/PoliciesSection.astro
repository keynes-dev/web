---
import Section from "@/components/section/Section.astro";
import CodeBlock from "@/components/ui/CodeBlock.astro";
import Card from "@/components/ui/Card.astro";
import CardContent from "@/components/ui/CardContent.astro";
import CardHeader from "@/components/ui/CardHeader.astro";
import CardTitle from "@/components/ui/CardTitle.astro";

const policyExamples = [
  {
    id: "sales",
    tab: "Sales",
    file: "lead-enrichment-policy.ts",
    policy: `const salesPolicy = db
  .selectFrom("opportunity")
  .select((eb) =>
    eb.case()
      .when("stage", "=", "qualified")
      .then(8).else(2)
      .end().as("dataCredits"),
  );`,
    requested: 6,
    available: 12,
    conditions: [
      { name: "Qualified opportunity", limit: 8 },
      { name: "New lead", limit: 2 },
    ],
  },
  {
    id: "support",
    tab: "Support",
    file: "ticket-traige-policy.ts",
    policy: `const supportPolicy = db
  .selectFrom("ticket")
  .select((eb) =>
    eb.case()
      .when("priority", "=", "urgent")
      .then(30).else(10)
      .end().as("minutes"),
  );`,
    requested: 25,
    available: 45,
    conditions: [
      { name: "Urgent", limit: 30 },
      { name: "Normal", limit: 10 },
    ],
  },
  {
    id: "engineering",
    tab: "Engineering",
    file: "ci-remediation-policy.ts",
    policy: `const ciRemediationPolicy = db
  .selectFrom("ci_failure")
  .select((eb) =>
    eb.case()
      .when("workClass", "=", "release_blocker")
      .then(45).else(10)
      .end().as("sandboxMinutes"),
  );`,
    requested: 30,
    available: 60,
    conditions: [
      { name: "Release blocker", limit: 45 },
      { name: "Routine PR", limit: 10 },
    ],
  },
] as const;

const percent = (value: number, total: number) =>
  `${((100 * value) / total).toFixed(2)}%`;

const panels = policyExamples.map((example) => ({
  ...example,
  bars: example.conditions.map(({ name, limit }) => ({
    name,
    limit,
    approved: example.requested <= limit,
    allowed: percent(Math.min(example.requested, limit), example.available),
    refused: percent(Math.max(example.requested - limit, 0), example.available),
    mark: percent(limit, example.available),
  })),
}));
---

<Section id='policies' aria-label='Context-aware policy examples'>
  <article class='grid min-w-0 items-center gap-10 lg:grid-cols-2 lg:gap-16'>
    <header class='flex flex-col gap-4'>
      <h2>Context-aware policies</h2>
      <p class='section-description max-w-md'>
        How much is enough? The right amount to budget depends on the current
        context. Keynes lets you build dynamic context-aware resource policies
        that adapt to your business.
      </p>
    </header>

    <div
      class='mx-auto flex w-full max-w-sm flex-col gap-4'
      data-policies-section
    >
      <div
        hidden
        class='flex gap-3'
        role='tablist'
        aria-label='Illustrative team policies'
        data-policies-tablist
      >
        {
          panels.map((panel, index) => (
            <button
              class='-mb-px border-b-2 border-transparent pb-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground aria-selected:border-foreground aria-selected:font-medium aria-selected:text-foreground'
              id={`policy-tab-${panel.id}`}
              role='tab'
              type='button'
              aria-controls={`policy-panel-${panel.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
              data-policies-tab
            >
              {panel.tab}
            </button>
          ))
        }
      </div>

      {
        panels.map((panel) => (
          <section
            id={`policy-panel-${panel.id}`}
            role='tabpanel'
            aria-labelledby={`policy-tab-${panel.id}`}
            tabindex='0'
            data-policies-panel
          >
            <Card>
              <CardHeader class='flex w-full items-center justify-between'>
                <CardTitle class='text-xs'>{panel.file}</CardTitle>
                <CardTitle class='text-xs'>{`{}`} TypeScript</CardTitle>
              </CardHeader>
              <CardContent class='border-b-2 p-0'>
                <CodeBlock
                  label={`${panel.file} policy`}
                  source={panel.policy}
                />
              </CardContent>
              <CardContent class='flex flex-col gap-4'>
                {panel.bars.map((bar) => (
                  <div class='flex flex-col gap-1.5'>
                    <p class='flex items-baseline justify-between gap-3 text-xs'>
                      {bar.name}
                      <span
                        class:list={[
                          "font-mono text-xs",
                          bar.approved ? "text-success" : "text-danger",
                        ]}
                      >
                        {bar.approved ? "APPROVED" : "DENIED"}
                      </span>
                    </p>
                    <div class='relative h-3 border-b' aria-hidden='true'>
                      <span
                        class='absolute bottom-0 left-0 h-1.5 bg-success'
                        style={{ width: bar.allowed }}
                      />
                      {!bar.approved && (
                        <span
                          class='absolute bottom-0 h-1.5 bg-danger-subtle'
                          style={{
                            left: bar.allowed,
                            width: bar.refused,
                          }}
                        />
                      )}
                      <span
                        class='absolute inset-y-0 border-l'
                        style={{ left: bar.mark }}
                      />
                    </div>
                    <div class='relative flex justify-between font-mono text-tiny text-muted-foreground'>
                      <span>0</span>
                      <span
                        class='absolute -translate-x-1/2'
                        style={{ left: bar.mark }}
                      >
                        limit: {bar.limit}
                      </span>
                      <span>{panel.available}</span>
                    </div>
                  </div>
                ))}
              </CardContent>
            </Card>
          </section>
        ))
      }
    </div>
  </article>
</Section>

<script>
  import { bindTabs } from "@/lib/tabs";

  for (const section of document.querySelectorAll<HTMLElement>(
    "[data-policies-section]",
  )) {
    const tablist = section.querySelector<HTMLElement>(
      "[data-policies-tablist]",
    );
    const tabs = Array.from(
      section.querySelectorAll<HTMLButtonElement>("[data-policies-tab]"),
    );
    const panels = Array.from(
      section.querySelectorAll<HTMLElement>("[data-policies-panel]"),
    );

    if (!tablist || tabs.length === 0 || panels.length === 0) continue;

    tablist.hidden = false;

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel, panelIndex) => {
        panel.hidden = panelIndex !== index;
      });
    };

    bindTabs({
      tabs,
      onSelect: ({ index, focus }) => select(index, focus),
    });

    select(0);
  }
</script>
