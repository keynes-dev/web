---
import { Icon } from "astro-icon/components";

import Section from "@/components/section/Section.astro";
import Button from "@/components/ui/Button.astro";
import { accessLinks } from "../access-links";
---

<Section class="bg-orange-100">
  <svg
    slot="decoration"
    class="pointer-events-none absolute inset-0 size-full text-border/5"
    aria-hidden="true"
  >
    <defs>
      <pattern
        id="hero-grid"
        width="32"
        height="16"
        patternUnits="userSpaceOnUse"
      >
        <path d="M0 8 16 0 32 8 16 16Z" fill="none" stroke="currentColor" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-grid)" />
  </svg>
  <div>
    <div class="flex flex-col gap-6 lg:min-h-80 lg:justify-center">
      <div class="relative lg:max-w-1/2">
        <header class="space-y-4">
          <h1>Runtime economics for agents</h1>
          <p class="max-w-3xl text-muted-foreground">
            Give your agents observability into your business with programmable
            resource controls for tokens, tools, time, and more.
          </p>
        </header>
        <div class="mt-4 flex flex-wrap gap-3">
          {accessLinks.map((link) => (
            <Button href={link.href} size="lg" variant={link.variant}>
              {link.label}
              {link.href === "/access" && (
                <Icon
                  name="hugeicons:arrow-right-01"
                  class="size-4"
                  aria-hidden="true"
                />
              )}
            </Button>
          ))}
        </div>
      </div>
    </div>
  </div>
  <conveyor-belt
    slot="full-bleed"
    class="pointer-events-none relative block h-56 border-border/10 text-foreground sm:h-64 lg:absolute lg:inset-0 lg:h-auto"
    role="img"
    aria-label="A machine sorting shapes into boxes on a conveyor belt: each box receives the shape that fits the hole in its lid, and one that arrives the wrong way up is turned over by a mechanical arm."
  ></conveyor-belt>
</Section>

<script>
  import "./conveyor/element.js";
</script>
