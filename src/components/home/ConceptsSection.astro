---
import { Icon } from "astro-icon/components";

import Section from "@/components/section/Section.astro";

const concepts = [
  {
    title: "Budgets",
    caption: "Allocate resources across teams, agents, and workflows.",
    icon: "hugeicons:piggy-bank",
  },
  {
    title: "Policies",
    caption: "Decide what each task can use based on business context.",
    icon: "hugeicons:policy",
  },
  {
    title: "Experiments",
    caption: "Test which resource policies produce the best results.",
    icon: "hugeicons:covariate",
  },
] as const;
---

<Section aria-label="Budgets, policies, and experiments" padded={false}>
  <div class="grid lg:grid-cols-3">
    {concepts.map((concept) => (
      <article class="relative border-b last:border-b-0 lg:border-b-0 lg:border-r lg:last:border-r-0">
        <div class="flex h-full flex-col gap-4 p-4">
          <header class="flex flex-col gap-2">
            <span class="flex items-center gap-3">
              <Icon
                name={concept.icon}
                class="size-4"
                stroke-width="1.5"
                aria-hidden="true"
              />
              <h3>{concept.title}</h3>
            </span>
            <p class="max-w-sm text-sm text-muted-foreground">
              {concept.caption}
            </p>
          </header>
        </div>
      </article>
    ))}
  </div>
</Section>
