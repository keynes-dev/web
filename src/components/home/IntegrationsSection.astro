---
import { Icon } from "astro-icon/components";
import Section from "@/components/section/Section.astro";
import Card from "@/components/ui/Card.astro";
import PlatformComponent from "@/components/home/PlatformComponent.astro";

const ringWidth = 34;
const ringPitch = 110;
const innerRingCenter = 185;

function ringAt(centerRadius: number) {
  return {
    innerRadius: centerRadius - ringWidth / 2,
    outerRadius: centerRadius + ringWidth / 2,
  };
}

const innerRing = ringAt(innerRingCenter);
const middleRing = ringAt(innerRingCenter + ringPitch);
const outerRing = ringAt(innerRingCenter + ringPitch * 2);

const groups = [
  {
    id: "resources",
    title: "Models and paid tools",
    ring: outerRing,
    tools: [
      { id: "gemini", name: "Gemini", icon: "google-gemini-icon" },
      { id: "openai", name: "OpenAI", icon: "openai-icon" },
      { id: "anthropic", name: "Anthropic", icon: "anthropic-icon" },
      { id: "twilio", name: "Twilio", icon: "twilio-icon" },
      { id: "firecrawl", name: "Firecrawl", icon: "firecrawl" },
    ],
  },
  {
    id: "frameworks",
    title: "Agent frameworks",
    ring: innerRing,
    tools: [
      { id: "ai-sdk", name: "Vercel AI SDK", icon: "vercel-ai-sdk" },
      { id: "langgraph", name: "LangGraph", icon: "langgraph" },
    ],
  },
  {
    id: "observability",
    title: "Observability and analytics",
    ring: middleRing,
    tools: [
      { id: "grafana", name: "Grafana", icon: "grafana" },
      { id: "datadog", name: "Datadog", icon: "datadog-icon" },
      { id: "posthog", name: "PostHog", icon: "posthog-icon" },
      { id: "sentry", name: "Sentry", icon: "sentry-icon" },
      { id: "langfuse", name: "Langfuse", icon: "langfuse" },
    ],
  },
];

const diagram = { width: 960, height: 480, centerX: 480, centerY: 480 };

function pointOnArc(radius: number, angle: number) {
  const radians = (angle * Math.PI) / 180;
  return {
    x: diagram.centerX + radius * Math.cos(radians),
    y: diagram.centerY - radius * Math.sin(radians),
  };
}

function bandPath(ring: typeof outerRing) {
  return [
    `M ${diagram.centerX - ring.outerRadius} ${diagram.centerY}`,
    `A ${ring.outerRadius} ${ring.outerRadius} 0 0 1 ${diagram.centerX + ring.outerRadius} ${diagram.centerY}`,
    `L ${diagram.centerX + ring.innerRadius} ${diagram.centerY}`,
    `A ${ring.innerRadius} ${ring.innerRadius} 0 0 0 ${diagram.centerX - ring.innerRadius} ${diagram.centerY}`,
    "Z",
  ].join(" ");
}

function ringOutlinePath(ring: typeof outerRing) {
  return [
    `M ${diagram.centerX - ring.outerRadius} ${diagram.centerY}`,
    `A ${ring.outerRadius} ${ring.outerRadius} 0 0 1 ${diagram.centerX + ring.outerRadius} ${diagram.centerY}`,
    `M ${diagram.centerX - ring.innerRadius} ${diagram.centerY}`,
    `A ${ring.innerRadius} ${ring.innerRadius} 0 0 1 ${diagram.centerX + ring.innerRadius} ${diagram.centerY}`,
  ].join(" ");
}

function dividerPath(ring: typeof outerRing, sectorCount: number) {
  const dividerAngles = Array.from(
    { length: sectorCount - 1 },
    (_, index) => 180 - (180 / sectorCount) * (index + 1),
  );
  return dividerAngles
    .map((angle) => {
      const outer = pointOnArc(ring.outerRadius, angle);
      const inner = pointOnArc(ring.innerRadius, angle);
      return `M ${outer.x} ${outer.y} L ${inner.x} ${inner.y}`;
    })
    .join(" ");
}

function positionOnRing(ring: typeof outerRing, angle: number) {
  const centerRadius = (ring.innerRadius + ring.outerRadius) / 2;
  const point = pointOnArc(centerRadius, angle);
  return {
    x: (point.x / diagram.width) * 100,
    y: (point.y / diagram.height) * 100,
  };
}

function iconPosition(
  ring: typeof outerRing,
  index: number,
  sectorCount: number,
) {
  const centerAngle = 180 - (180 / sectorCount) * (index + 0.5);
  return positionOnRing(ring, centerAngle);
}
---

<Section
  id='integrations'
  aria-labelledby='integrations-title'
  class='scroll-mt-20'
  padded={false}
>
  <div class='flex flex-col'>
    <header
      class='flex flex-col items-center gap-4 px-4 pt-8 text-center sm:px-8 sm:pt-12'
    >
      <h2 id='integrations-title'>Bring your own stack.</h2>
      <p class='max-w-xl text-base leading-relaxed text-muted-foreground'>
        Keynes plays well with others. Integrate Keynes into your existing
        orchestration framework, observability tools, and model and tool
        providers.
      </p>
    </header>

    <div
      class='integration-diagram relative aspect-[2/1] overflow-hidden [container-type:inline-size]'
    >
      <svg
        class='absolute inset-0 size-full'
        viewBox='0 0 960 480'
        preserveAspectRatio='none'
        fill='none'
        role='group'
        aria-label='Integration groups'
      >
        {
          groups.map((group) => (
            <g>
              <path
                data-ring-band={group.id}
                data-integration-trigger={group.id}
                class='integration-band'
                d={bandPath(group.ring)}
                role='button'
                tabindex='0'
                aria-label={group.title}
                aria-pressed='false'
              />
              <path
                class='pointer-events-none stroke-foreground/20'
                d={ringOutlinePath(group.ring)}
              />
              <path
                class='pointer-events-none stroke-foreground/20'
                d={dividerPath(group.ring, group.tools.length)}
              />
            </g>
          ))
        }
      </svg>

      {
        groups.map((group) => (
          <div class='contents' data-integration-group={group.id}>
            <ul class='contents' aria-label={group.title}>
              {group.tools.map((tool, index) => {
                const position = iconPosition(
                  group.ring,
                  index,
                  group.tools.length,
                );
                return (
                  <li
                    class='integration-logo'
                    data-integration-trigger={group.id}
                    style={`--logo-x: ${position.x}%; --logo-y: ${position.y}%;`}
                    aria-label={tool.name}
                    aria-pressed='false'
                    role='button'
                    tabindex='0'
                  >
                    <span class='integration-label' aria-hidden='true'>
                      {tool.name}
                    </span>
                    <Card class='logo-tile size-14 items-center justify-center rounded-xl border bg-card'>
                      <Icon
                        name={`integrations/${tool.icon}`}
                        class='size-7'
                        aria-hidden='true'
                      />
                    </Card>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }

      <div
        class='pointer-events-none absolute inset-x-0 bottom-0 z-10 h-px bg-border'
        aria-hidden='true'
      >
      </div>
    </div>
  </div>

  <PlatformComponent />
</Section>

<script>
  const integrationSection =
    document.querySelector<HTMLElement>("#integrations");

  if (integrationSection) {
    const triggers = Array.from(
      integrationSection.querySelectorAll<HTMLElement | SVGElement>(
        "[data-integration-trigger]",
      ),
    );
    const supportsHover = window.matchMedia("(hover: hover)");
    let activeGroup: string | null = null;
    let hoveredGroup: string | null = null;
    let focusedGroup: string | null = null;

    const groupFor = (trigger: HTMLElement | SVGElement) =>
      trigger.getAttribute("data-integration-trigger");

    const renderHighlight = () => {
      const highlightedGroup = hoveredGroup ?? focusedGroup ?? activeGroup;

      if (highlightedGroup) {
        integrationSection.dataset.highlightedIntegration = highlightedGroup;
      } else {
        delete integrationSection.dataset.highlightedIntegration;
      }

      triggers.forEach((trigger) => {
        trigger.setAttribute(
          "aria-pressed",
          String(groupFor(trigger) === activeGroup),
        );
      });
    };

    triggers.forEach((trigger) => {
      if (supportsHover.matches) {
        trigger.addEventListener("pointerenter", () => {
          hoveredGroup = groupFor(trigger);
          renderHighlight();
        });
        trigger.addEventListener("pointerleave", () => {
          hoveredGroup = null;
          renderHighlight();
        });
      }

      trigger.addEventListener("focus", () => {
        focusedGroup = groupFor(trigger);
        renderHighlight();
      });
      trigger.addEventListener("blur", () => {
        focusedGroup = null;
        renderHighlight();
      });
      trigger.addEventListener("click", () => {
        const group = groupFor(trigger);
        activeGroup = activeGroup === group ? null : group;
        renderHighlight();
      });
      trigger.addEventListener("keydown", (event) => {
        if (!(event instanceof KeyboardEvent)) return;

        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          trigger.dispatchEvent(new MouseEvent("click", { bubbles: true }));
        }
      });
    });

    document.addEventListener("click", (event) => {
      if (
        event.target instanceof Element &&
        event.target.closest("[data-integration-trigger]")
      ) {
        return;
      }

      activeGroup = null;
      renderHighlight();
    });
  }
</script>

<style>
  [data-ring-band] {
    fill: var(--muted);
    transition: fill 160ms ease;
  }
  .integration-band {
    cursor: pointer;
  }
  .integration-logo {
    position: absolute;
    left: var(--logo-x);
    top: var(--logo-y);
    transform: translate(-50%, -50%);
  }
  .logo-tile {
    transition:
      background-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }
  .integration-label {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    z-index: 20;
    transform: translate(-50%, 0.25rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--card);
    padding: 0.25rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }
  .integration-logo:hover {
    z-index: 10;
  }
  .integration-logo:hover .logo-tile {
    transform: translateY(-2px);
    box-shadow: 0 4px 0 var(--foreground);
  }
  .integration-logo:hover .integration-label {
    transform: translate(-50%, 0);
    opacity: 1;
  }
  @media (max-width: 47.999rem) {
    .integration-diagram .logo-tile {
      width: clamp(18px, 5.5cqw, 22px);
      height: clamp(18px, 5.5cqw, 22px);
      border-radius: clamp(3px, 1cqw, 4px);
    }
    .integration-diagram .logo-tile svg {
      width: clamp(10px, 3cqw, 12px);
      height: clamp(10px, 3cqw, 12px);
    }
    .integration-diagram .otel-label {
      bottom: 0.125rem;
      gap: 0.25rem;
      padding: 0.125rem 0.375rem;
      font-size: 0.5625rem;
      line-height: 0.875rem;
    }
    .integration-diagram .otel-label svg {
      width: 0.875rem;
      height: 0.875rem;
    }
  }
  @media (hover: none) {
    .integration-label {
      display: none;
    }
    .integration-logo:hover .logo-tile {
      transform: none;
      box-shadow: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-ring-band],
    .logo-tile,
    .integration-label {
      transition: none;
    }
  }
</style>

<style is:global>
  #integrations[data-highlighted-integration="resources"]
    [data-ring-band="resources"] {
    fill: var(--color-orange-200);
  }
  #integrations[data-highlighted-integration="resources"]
    [data-platform-group="resources"] {
    background-color: var(--color-orange-200);
    color: var(--foreground);
  }
  #integrations[data-highlighted-integration="resources"]
    [data-platform-group="resources"]
    p {
    color: var(--muted-foreground);
  }
  #integrations[data-highlighted-integration="frameworks"]
    [data-ring-band="frameworks"] {
    fill: var(--color-green-200);
  }
  #integrations[data-highlighted-integration="frameworks"]
    [data-platform-group="frameworks"] {
    background-color: var(--color-green-200);
    color: var(--foreground);
  }
  #integrations[data-highlighted-integration="frameworks"]
    [data-platform-group="frameworks"]
    p {
    color: var(--muted-foreground);
  }
  #integrations[data-highlighted-integration="observability"]
    [data-ring-band="observability"] {
    fill: var(--color-sky-200);
  }
  #integrations[data-highlighted-integration="observability"]
    [data-platform-group="observability"] {
    background-color: var(--color-sky-200);
    color: var(--foreground);
  }
  #integrations[data-highlighted-integration="observability"]
    [data-platform-group="observability"]
    p {
    color: var(--muted-foreground);
  }
</style>
