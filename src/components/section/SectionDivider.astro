---
import GridMarks from "./GridMarks.astro";
---

<div aria-hidden="true" class="section-divider relative border-b">
  <div class="relative container mx-auto px-4 md:px-0 xl:border-x xl:border-transparent">
    <GridMarks class="max-xl:hidden" />
    <div class="relative mx-auto h-4 max-w-screen-lg border-x border-transparent">
      <GridMarks />
    </div>
  </div>
</div>

<style>
  .section-divider {
    background-image: repeating-linear-gradient(
      135deg,
      transparent 0 5px,
      color-mix(in oklab, var(--border) 15%, transparent) 5px 6px
    );
  }
</style>
