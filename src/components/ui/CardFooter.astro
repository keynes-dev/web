---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

type Props = HTMLAttributes<"footer">;
const { class: className, ...attrs } = Astro.props;
---

<footer
  class={cn(
    "rounded-b-[calc(var(--radius-sm)-2px)] border-t-2 border-border p-3",
    className,
  )}
  {...attrs}
>
  <slot />
</footer>
