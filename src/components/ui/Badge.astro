---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

type Props = HTMLAttributes<"span"> & {
  className?: string;
};

const { class: classAttr, className, ...attrs } = Astro.props;
---

<span
  class={cn(
    "inline-flex w-fit shrink-0 items-center rounded-full bg-foreground px-3 py-1 text-xs font-semibold whitespace-nowrap text-white",
    classAttr,
    className,
  )}
  {...attrs}
>
  <slot />
</span>
